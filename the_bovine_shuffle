Задача: The Bovine Shuffle
Теги: #simulation
Код:
#include <bits/stdc++.h>
using namespace std;
int main() {
    freopen("shuffle.in", "r", stdin);
    freopen("shuffle.out", "w", stdout);
    int n;
    cin >> n;
    vector<int> a(n+1);
    vector<int> id(n+1);
    for (int i=1; i<=n; i++) cin >> a[i];
    for (int i=1; i<=n; i++) cin >> id[i];
    int three=3;
    vector<int> new_id(n+1);
    while (three--) {
    for (int i=1; i<=n; i++) {
    new_id[i]=id[a[i]];
    }
    id=new_id;
    }
    for (int i=1; i<=n; i++) cout << new_id[i] << "\n";
}

Примечение: Можно было обойтись с нулевой индексацией.
