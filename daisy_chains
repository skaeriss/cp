ДОСТАЛА задача! СПОТЫКАЛАСЬ на самом легком. Идея простая, просто идем слева направо.
Заводим вектор с элементами, которые уже были, ака seen и переменную sum.
Обновляем сумму всех лепестков и seen на каждом внешнем цикле.
Потом считаем количество цветочков на данном отрезке: right-left+1;
+1 тк в данном отрезке мы учитывыем правую границу тоже "]".
Потом проверяем делимость суммы на количество, если не делится, 
значит среднего точно не будет, тк у нас цветы только с целыми значениями.
Если таки делится, то проверяем наличие в seen и ecли true, то ans++;

ВАЖНО!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
for (int i = 0; i < n; i++) {       // i — ЛЕВАЯ граница (стоит на месте)
    for (int j = i; j < n; j++) {   // j — ПРАВАЯ граница (двигается)
        
        // Всё, что добавляется НА КАЖДОМ ШАГУ расширения отрезка,
        // должно использовать индекс J, потому что двигается именно J!
        sum += p[j]; 
    }
}
Код:
#include <bits/stdc++.h>
using namespace std;
int main() {
   int n;
   cin >> n;
   vector<int> p(n);
   for (int i=0; i<n; i++) cin >> p[i];
   int ans=0;
   for (int i=0; i<n; i++) {
       int sum=0;
       vector<int> seen;
       for (int j=i; j<n; j++) {
           sum+=p[j];
           seen.push_back(p[j]);
           int cnt=j-i+1;
           if (sum%cnt==0) {
               int average=sum/cnt;
               if (find(seen.begin(), seen.end(), average)!=seen.end()) ans++;
           }
       }
   }
   cout << ans;
}
