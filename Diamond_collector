Код:
#include <bits/stdc++.h>
using namespace std;
int main() {
    freopen("diamond.in", "r", stdin);
    freopen("diamond.out", "w", stdout);
    int n, k;
    cin >> n >> k;
    vector<int> d(n);
    for (int i=0; i<n; i++) {
        cin >> d[i];
    }
    int ans=0;
    sort(d.begin(), d.end());
        for (int i=0; i<n; i++) {
            int cnt=0;
            for (int j=i; j<n; j++) {
                if (d[j]-d[i]>k) break;
                else cnt++;
            }
            ans=max(cnt, ans);
        }
        cout << ans;
}
